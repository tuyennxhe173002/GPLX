POSTGRES_DB=gplx
POSTGRES_USER=gplx
POSTGRES_PASSWORD=change-me-postgres-password

APP_AUTH_JWT_SECRET=replace-with-a-long-random-base64-secret
APP_CORS_ALLOWED_ORIGIN=https://your-domain.example
APP_AUTH_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
APP_AUTH_REFRESH_TOKEN_EXPIRATION_SECONDS=2592000

APP_SEED_ENABLED=false
APP_SEED_LOCATION=data
APP_SEED_VALIDATION_MODE=FULL

FRONTEND_PORT=80
BACKEND_PORT=8080
